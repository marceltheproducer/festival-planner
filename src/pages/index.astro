---
import Layout from "../layouts/Layout.astro";
import { getAllFestivals } from "../lib/festivals";
import { cityCoords, projectXY } from "../lib/cityCoords";

const festivals = getAllFestivals();
const total = festivals.length;
const oscar = festivals.filter((f) => /oscar|academy award/i.test(f.notes ?? "")).length;
const regions = new Set(festivals.map((f) => f.location.region)).size;
const aListCount = festivals.filter((f) => f.tier === "A-list").length;

// Fig. 1 — one plotted dot per festival, positioned by real geography.
const dots = festivals
  .map((f, i) => {
    const c = cityCoords[`${f.location.city}, ${f.location.country}`];
    if (!c) return null;
    const { x, y } = projectXY(c[0], c[1]);
    // deterministic jitter so festivals sharing a city fan out instead of stacking
    const jx = (((i * 37) % 7) - 3) * 0.45;
    const jy = (((i * 53) % 7) - 3) * 0.45;
    return { x: x + jx, y: y + jy, aList: f.tier === "A-list", name: f.name };
  })
  .filter((d): d is { x: number; y: number; aList: boolean; name: string } => d !== null);

const features = [
  {
    href: "/browse",
    no: "I",
    title: "The Circuit",
    body: "Every festival, filterable by genre, region, tier, premiere rules, fee, and deadline. Sorted so the soonest — and cheapest — rise to the top.",
    cta: "Browse festivals",
  },
  {
    href: "/calendar",
    no: "II",
    title: "The Diary",
    body: "All your deadlines on one calendar, colour-coded by type. Red means a fee is due; you'll never blow a window again.",
    cta: "Open the diary",
  },
  {
    href: "/planner",
    no: "III",
    title: "The Dispatch",
    body: "Tell us about your film — we plot the whole run in the order that protects your premiere and your budget, with a plan you can export.",
    cta: "Build your plan",
  },
];

const steps = [
  { step: "1", title: "Browse", desc: "Explore festivals filtered by what matters to your film." },
  { step: "2", title: "Learn premieres", desc: "See which festivals want world, international, or national premieres." },
  { step: "3", title: "Plan the run", desc: "Get a phased submission plan built around your ready date and budget." },
  { step: "4", title: "Track deadlines", desc: "Keep the diary close so no submission window slips by." },
];
---

<Layout
  newsprint
  title="Home"
  description="Stop guessing which film festivals to submit to. Browse deadlines, protect your premiere status, and build an optimal submission strategy — a free tool by a filmmaker, for filmmakers."
>
  <div class="np-page">
    <!-- HERO -->
    <section class="hero">
      <p class="np-kicker">The lead · this season on the circuit</p>
      <h1>Stop guessing. <span class="over">Start submitting.</span></h1>
      <p class="deck">Deadlines, premiere rules, fees, and a submission plan built around <em>your</em> film and <em>your</em> budget — no jargon, no "synergy," no $600 in wasted entry fees.</p>
      <div class="btnrow">
        <a class="np-btn np-btn-solid" href="/browse">Browse the circuit</a>
        <a class="np-btn np-btn-ghost" href="/planner">Build my plan</a>
      </div>
    </section>

    <!-- FIG. 1 — THE MAP -->
    <figure class="map-fig">
      <div class="map" role="img" aria-label={`World map plotting all ${total} tracked festivals`}>
        <span class="rlabel" style="left:15%;top:22%">N. America</span>
        <span class="rlabel" style="left:50%;top:18%">Europe</span>
        <span class="rlabel" style="left:80%;top:30%">Asia</span>
        <span class="rlabel" style="left:52%;top:70%">Africa</span>
        <span class="rlabel" style="left:28%;top:82%">S. America</span>
        <span class="rlabel" style="left:88%;top:82%">Oceania</span>
        {dots.map((d) => (
          <span class:list={["dot", { alist: d.aList }]} style={`left:${d.x}%;top:${d.y}%`} title={d.name}></span>
        ))}
      </div>
      <figcaption>
        <span class="fig">Fig. 1</span> — {total} festivals across {regions} regions.
        <span class="lg"><i class="d mus"></i> {aListCount} A-list</span>
        <span class="lg"><i class="d red"></i> {total - aListCount} more on the circuit</span>
      </figcaption>
    </figure>

    <!-- BY THE NUMBERS -->
    <div class="np-bynum">
      <div class="n"><div class="big">{total}</div><div class="lab">Festivals tracked</div></div>
      <div class="n"><div class="big">{oscar}</div><div class="lab">Oscar-qualifying</div></div>
      <div class="n"><div class="big">{regions}</div><div class="lab">Regions covered</div></div>
      <div class="n"><div class="big paper">$0</div><div class="lab">To start planning</div></div>
    </div>

    <!-- FEATURES -->
    <div class="np-secrule"><h2>What's inside</h2><span class="l"></span><span class="n">three desks, one newsroom</span></div>
    <div class="features">
      {features.map((f) => (
        <a href={f.href} class="feat">
          <div class="feat-top"><span class="feat-no">{f.no}</span></div>
          <h3>{f.title}</h3>
          <p>{f.body}</p>
          <span class="feat-cta">{f.cta} →</span>
        </a>
      ))}
    </div>

    <!-- HOW IT WORKS -->
    <div class="np-secrule"><h2>How it works</h2><span class="l"></span><span class="n">four steps, in order</span></div>
    <ol class="steps">
      {steps.map((s) => (
        <li>
          <span class="s-no">{s.step}</span>
          <div>
            <h4>{s.title}</h4>
            <p>{s.desc}</p>
          </div>
        </li>
      ))}
    </ol>

    <!-- CLOSING CTA -->
    <div class="closer">
      <div>
        <div class="closer-h">You made the film.</div>
        <div class="closer-s">The hard part's over. Let's get it seen.</div>
      </div>
      <a class="np-btn np-btn-ink" href="/planner">Build my plan →</a>
    </div>
  </div>
</Layout>

<style>
  .np-page { max-width: 1120px; margin: 0 auto; padding: 0 clamp(14px,3vw,32px); }

  /* HERO — full width */
  .hero { padding: clamp(26px,5vw,60px) 0 clamp(20px,3vw,30px); }
  .hero h1 { font-family: var(--np-display); text-transform: uppercase; font-weight: 400; line-height: 0.84;
    letter-spacing: 0.004em; margin: 12px 0 18px; font-size: clamp(58px, 13vw, 168px); text-wrap: balance; max-width: 15ch; }
  .hero h1 .over { color: var(--np-red); text-shadow: 4px 0 0 rgba(39,75,142,0.6); }
  .deck { font-family: var(--np-serif); font-size: clamp(16px,2vw,22px); line-height: 1.5; max-width: 52ch; color: var(--np-ink-2); }
  .deck::first-letter { font-family: var(--np-display); font-size: 3.2em; float: left; line-height: 0.7; padding: 4px 10px 0 0; color: var(--np-red); }
  .btnrow { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 24px; }

  /* FIG. 1 — the map (festivals plotted by real geography) */
  .map-fig { margin: 0 0 clamp(20px,3vw,32px); border-top: 2px solid var(--np-ink); padding-top: 16px; }
  .map { position: relative; width: 100%; aspect-ratio: 2.5 / 1; border: 2.5px solid var(--np-ink); background: var(--np-paper-2);
    box-shadow: 7px 7px 0 var(--np-ink); overflow: hidden;
    background-image:
      linear-gradient(var(--np-line) 1px, transparent 1px),
      linear-gradient(90deg, var(--np-line) 1px, transparent 1px);
    background-size: 8.333% 16.66%, 8.333% 16.66%; }
  @media (max-width: 640px){ .map { aspect-ratio: 1.6 / 1; } }
  .dot { position: absolute; width: 8px; height: 8px; border-radius: 50%; background: var(--np-red);
    border: 1px solid var(--np-ink); transform: translate(-50%,-50%); box-shadow: 0 0 0 2px color-mix(in srgb, var(--np-paper-2) 70%, transparent); }
  .dot.alist { width: 11px; height: 11px; background: var(--np-mustard); z-index: 2; }
  .rlabel { position: absolute; transform: translate(-50%,-50%); font-family: var(--np-mono); font-size: 10px; font-weight: 600;
    letter-spacing: 0.14em; text-transform: uppercase; color: var(--np-ink-2); opacity: 0.55; pointer-events: none; white-space: nowrap; }
  @media (max-width: 640px){ .rlabel { font-size: 8px; } .dot { width: 6px; height: 6px; } .dot.alist { width: 8px; height: 8px; } }
  .map-fig figcaption { font-family: var(--np-mono); font-size: 12px; color: var(--np-ink-2); margin-top: 10px;
    display: flex; flex-wrap: wrap; align-items: center; gap: 6px 16px; }
  .map-fig .fig { font-weight: 700; color: var(--np-ink); letter-spacing: 0.06em; }
  .map-fig .lg { display: inline-flex; align-items: center; gap: 6px; text-transform: uppercase; letter-spacing: 0.04em; font-size: 11px; }
  .map-fig .lg .d { width: 11px; height: 11px; border-radius: 50%; border: 1px solid var(--np-ink); display: inline-block; }
  .map-fig .lg .d.mus { background: var(--np-mustard); }
  .map-fig .lg .d.red { background: var(--np-red); }

  /* FEATURES */
  .features { display: grid; grid-template-columns: repeat(3,1fr); gap: 20px; }
  @media (max-width: 820px){ .features { grid-template-columns: 1fr; max-width: 440px; } }
  .feat { display: block; text-decoration: none; color: var(--np-ink); background: var(--np-paper-2);
    border: 2.5px solid var(--np-ink); box-shadow: 6px 6px 0 var(--np-ink); padding: 18px; transition: transform .12s, box-shadow .12s; }
  .feat:hover { transform: translate(2px,2px); box-shadow: 4px 4px 0 var(--np-ink); }
  .feat-top { border-bottom: 1px dashed var(--np-line-2); padding-bottom: 10px; margin-bottom: 12px; }
  .feat-no { font-family: var(--np-display); font-size: 30px; color: var(--np-red); line-height: 1; }
  .feat h3 { font-family: var(--np-display); text-transform: uppercase; font-size: 30px; line-height: 0.95; margin: 0 0 8px; }
  .feat p { font-family: var(--np-serif); font-size: 14px; line-height: 1.55; color: var(--np-ink-2); margin: 0 0 14px; }
  .feat-cta { font-family: var(--np-mono); font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--np-ink);
    border-bottom: 2px solid var(--np-red); padding-bottom: 1px; }

  /* STEPS */
  .steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4,1fr); gap: 18px; }
  @media (max-width: 720px){ .steps { grid-template-columns: repeat(2,1fr); } }
  .steps li { display: flex; gap: 12px; align-items: flex-start; }
  .s-no { font-family: var(--np-display); font-size: 44px; line-height: 0.8; color: var(--np-mustard); flex: none; -webkit-text-stroke: 1px var(--np-ink); }
  .steps h4 { font-family: var(--np-display); text-transform: uppercase; font-size: 19px; margin: 4px 0 4px; letter-spacing: 0.02em; }
  .steps p { font-family: var(--np-serif); font-size: 13.5px; line-height: 1.5; color: var(--np-ink-2); margin: 0; }

  /* CLOSER */
  .closer { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px;
    background: var(--np-ink); color: var(--np-paper); padding: clamp(20px,3vw,32px); margin-top: clamp(30px,5vw,52px); }
  .closer-h { font-family: var(--np-display); text-transform: uppercase; font-size: clamp(26px,4vw,44px); line-height: 0.9; color: var(--np-mustard); }
  .closer-s { font-family: var(--np-serif); font-style: italic; font-size: clamp(14px,2vw,18px); opacity: 0.9; margin-top: 4px; }
</style>
