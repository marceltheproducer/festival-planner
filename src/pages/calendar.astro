---
import Layout from "../layouts/Layout.astro";
import DeadlineCalendar from "../components/DeadlineCalendar";
import { getAllFestivals } from "../lib/festivals";

const festivals = getAllFestivals();
---

<Layout newsprint title="Deadline Calendar" description="Visualize all film festival submission deadlines on an interactive calendar. Never miss a submission window again.">
  <div class="np-wrap">
    <header class="np-pagehead">
      <p class="np-kicker">The diary</p>
      <h1>Deadline diary</h1>
      <p class="np-pagehead__sub">
        Every submission window on one page. Click a date for details. Colour marks the deadline type, from early (blue) to final (red).
      </p>
    </header>
    <DeadlineCalendar festivals={festivals} client:idle />
  </div>
</Layout>
