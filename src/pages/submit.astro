---
import Layout from "../layouts/Layout.astro";
---

<Layout newsprint title="Submit" description="Report a bug, request a feature, or suggest a film festival to add to FestivalPlanner.">
  <div class="np-wrap" style="max-width: 720px;">
    <header class="np-pagehead">
      <p class="np-kicker">Letters to the editor</p>
      <h1>Tip the newsroom</h1>
      <p class="np-pagehead__sub">
        Spot a festival we're missing? Hit a bug? Want a feature? Send it our way and we'll take a look.
      </p>
    </header>

    <form id="submit-form" action="https://formspree.io/f/meerrjyw" method="POST" class="np-formcard">
      <!-- Type selector -->
      <div class="np-formrow">
        <span class="np-label">What are you filing?</span>
        <div class="np-radios">
          <label class="np-radio">
            <input type="radio" name="type" value="festival-request" checked class="sr-only" />
            <span class="np-radio__box">Festival Request</span>
          </label>
          <label class="np-radio">
            <input type="radio" name="type" value="bug-report" class="sr-only" />
            <span class="np-radio__box">Bug Report</span>
          </label>
          <label class="np-radio">
            <input type="radio" name="type" value="feature-request" class="sr-only" />
            <span class="np-radio__box">Feature Request</span>
          </label>
        </div>
      </div>

      <!-- Common fields -->
      <div class="np-formrow">
        <label class="np-label" for="name">Your name <span class="opt">(optional)</span></label>
        <input type="text" id="name" name="name" autocomplete="name" class="np-textinput" placeholder="Jane Doe" />
      </div>

      <div class="np-formrow">
        <label class="np-label" for="email">Email <span class="opt">(optional, for follow-up)</span></label>
        <input type="email" id="email" name="email" autocomplete="email" class="np-textinput" placeholder="you@example.com" />
      </div>

      <!-- Festival request fields -->
      <div id="festival-fields">
        <div class="np-formrow">
          <label class="np-label" for="festival-name">Festival name <span class="req">*</span></label>
          <input type="text" id="festival-name" name="festival_name" class="np-textinput" placeholder="e.g. Austin Film Festival" />
        </div>
        <div class="np-formrow" style="display:grid; grid-template-columns:1fr 1fr; gap:16px;">
          <div>
            <label class="np-label" for="festival-city">City</label>
            <input type="text" id="festival-city" name="festival_city" class="np-textinput" placeholder="Austin" />
          </div>
          <div>
            <label class="np-label" for="festival-country">Country</label>
            <input type="text" id="festival-country" name="festival_country" class="np-textinput" placeholder="USA" />
          </div>
        </div>
        <div class="np-formrow">
          <label class="np-label" for="festival-website">Website URL</label>
          <input type="url" id="festival-website" name="festival_website" class="np-textinput" placeholder="https://austinfilmfestival.com" />
        </div>
      </div>

      <!-- Bug / feature fields -->
      <div id="bug-fields" class="hidden">
        <div class="np-formrow">
          <label class="np-label" for="page-url">Page URL <span class="opt">(where did you see it?)</span></label>
          <input type="url" id="page-url" name="page_url" class="np-textinput" placeholder="https://fest.marcelperez.co/browse" />
        </div>
      </div>

      <!-- Description -->
      <div class="np-formrow">
        <label class="np-label" for="description">Details <span class="req">*</span></label>
        <textarea id="description" name="description" rows="4" required class="np-textarea" placeholder="Tell us more..."></textarea>
      </div>

      <!-- Honeypot -->
      <input type="text" name="_gotcha" class="hidden" tabindex="-1" autocomplete="off" />

      <button type="submit" class="np-btn np-btn-solid">Send it in →</button>
    </form>

    <div id="success-msg" class="np-msg ok hidden">
      <strong>Filed. Thank you.</strong>
      <p>We'll review it and get back to you if we need more.</p>
    </div>

    <div id="error-msg" class="np-msg err hidden">
      <strong>Something jammed.</strong>
      <p>Please try again, or email us directly.</p>
    </div>
  </div>
</Layout>

<script>
  const radios = document.querySelectorAll<HTMLInputElement>('input[name="type"]');
  const festivalFields = document.getElementById("festival-fields");
  const bugFields = document.getElementById("bug-fields");

  radios.forEach((radio) => {
    radio.addEventListener("change", () => {
      if (radio.value === "festival-request") {
        festivalFields?.classList.remove("hidden");
        bugFields?.classList.add("hidden");
      } else {
        festivalFields?.classList.add("hidden");
        bugFields?.classList.remove("hidden");
      }
    });
  });

  const form = document.getElementById("submit-form") as HTMLFormElement;
  const successMsg = document.getElementById("success-msg");
  const errorMsg = document.getElementById("error-msg");

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    successMsg?.classList.add("hidden");
    errorMsg?.classList.add("hidden");
    const data = new FormData(form);
    try {
      const res = await fetch(form.action, { method: "POST", body: data, headers: { Accept: "application/json" } });
      if (res.ok) {
        form.reset();
        form.classList.add("hidden");
        successMsg?.classList.remove("hidden");
      } else {
        errorMsg?.classList.remove("hidden");
      }
    } catch {
      errorMsg?.classList.remove("hidden");
    }
  });
</script>
