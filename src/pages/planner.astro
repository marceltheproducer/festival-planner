---
import Layout from "../layouts/Layout.astro";
import StrategyPlanner from "../components/StrategyPlanner";
import { getAllFestivals } from "../lib/festivals";

const festivals = getAllFestivals();
---

<Layout newsprint title="Strategy Planner" description="Build an optimized film festival submission strategy. Input your film details, select genres, and get a phased plan that protects your premiere status.">
  <div class="np-wrap" style="max-width: 920px;">
    <header class="np-pagehead">
      <p class="np-kicker">The strategy desk</p>
      <h1>Build your run</h1>
      <p class="np-pagehead__sub">
        Tell us about the film. We plot the whole submission run in the order that protects your premiere and your wallet.
      </p>
    </header>
    <StrategyPlanner festivals={festivals} client:load />
  </div>
</Layout>
