---
import Layout from "../layouts/Layout.astro";
import FestivalBrowser from "../components/FestivalBrowser";
import { getAllFestivals } from "../lib/festivals";

const festivals = getAllFestivals();
---

<Layout newsprint title="Browse Festivals" description="Search and filter film festivals by genre, region, tier, premiere requirements, fees, and deadlines. Find the perfect festivals for your film.">
  <div class="np-wrap">
    <header class="np-pagehead">
      <p class="np-kicker">The listings</p>
      <h1>On the circuit</h1>
      <p class="np-pagehead__sub">
        Every festival worth knowing — filter by format, genre, region, fee, and deadline. Each entry is a ticket you could punch.
      </p>
    </header>
    <FestivalBrowser festivals={festivals} client:idle />
  </div>
</Layout>
