---
import Layout from "../../layouts/Layout.astro";
import { getAllFestivals, getNextDeadline } from "../../lib/festivals";
import type { Festival } from "../../lib/types";

export function getStaticPaths() {
  const festivals = getAllFestivals();
  return festivals.map((f) => ({ params: { id: f.id }, props: { festival: f } }));
}

interface Props {
  festival: Festival;
}

const { festival } = Astro.props;
const allFestivals = getAllFestivals();
const nextDeadline = getNextDeadline(festival);
const now = new Date().toISOString().split("T")[0];
const oscar = /oscar|academy award/i.test(festival.notes ?? "");
const hasShortSchedule = !!(festival.shortDeadlines && festival.shortDeadlines.length > 0);

const platformLabels: Record<string, string> = {
  filmfreeway: "FilmFreeway",
  direct: "Direct Submission",
  withoutabox: "Withoutabox",
  other: "Other",
};
const typeLabel = festival.type === "both" ? "Shorts & Features" : festival.type === "short" ? "Short Films" : "Feature Films";
const premLabel = festival.premiereRequirement === "none"
  ? "No premiere requirement"
  : `${festival.premiereRequirement.charAt(0).toUpperCase() + festival.premiereRequirement.slice(1)} premiere`;

function formatDate(dateStr: string): string {
  return new Date(dateStr + "T00:00:00").toLocaleDateString("en-US", { weekday: "short", month: "long", day: "numeric", year: "numeric" });
}
function feeText(fee: number, shortFee?: number): string {
  if (fee === 0) return "Free";
  if (shortFee !== undefined) return `Shorts ${shortFee} / Features ${fee} ${festival.fees.currency}`;
  return `${fee} ${festival.fees.currency}`;
}

// Related festivals: scored by genre overlap, tier, region, premiere, and film type
const related = allFestivals
  .filter((f) => f.id !== festival.id)
  .map((f) => {
    let score = 0;
    const sharedGenres = f.genres.filter((g) => festival.genres.includes(g)).length;
    score += sharedGenres * 15;
    if (f.tier === festival.tier) score += 10;
    if (f.location.region === festival.location.region) score += 8;
    if (f.premiereRequirement === festival.premiereRequirement) score += 5;
    if (f.type === festival.type || f.type === "both" || festival.type === "both") score += 3;
    return { festival: f, score };
  })
  .filter((r) => r.score > 0)
  .sort((a, b) => b.score - a.score)
  .slice(0, 6)
  .map((r) => r.festival);
---

<Layout
  newsprint
  title={festival.name}
  description={`${festival.name} · ${festival.location.city}, ${festival.location.country}. ${festival.tier} tier film festival. Deadlines, fees, and submission info.`}
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Event",
    "name": festival.name,
    "description": festival.notes || `${festival.name} film festival in ${festival.location.city}, ${festival.location.country}.`,
    "startDate": festival.festivalDates?.start,
    "endDate": festival.festivalDates?.end,
    "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
    "eventStatus": "https://schema.org/EventScheduled",
    "location": { "@type": "Place", "name": festival.location.city, "address": { "@type": "PostalAddress", "addressLocality": festival.location.city, "addressCountry": festival.location.country } },
    "url": festival.website,
    "organizer": { "@type": "Organization", "name": festival.name, "url": festival.website },
  })} />

  <div class="np-wrap" style="max-width: 920px;">
    <nav class="np-crumb" aria-label="Breadcrumb">
      <a href="/browse">Browse</a> <span>›</span> <span>{festival.name}</span>
    </nav>

    <!-- Article header -->
    <div class={`np-article${oscar ? " has-stamp" : ""}`}>
      {oscar && <span class="np-stamp mus np-article__stamp">Oscar<br />Qual.</span>}
      <p class="np-article__kicker">{festival.tier} · {festival.location.region}</p>
      <h1>{festival.name}</h1>
      <p class="np-article__loc">{festival.location.city}, {festival.location.country} · {platformLabels[festival.submissionPlatform]}</p>

      <div class="np-article__meta">
        <span class="np-metatag prem">{premLabel}</span>
        <span class="np-metatag">{typeLabel}</span>
        {festival.genres.map((g) => <span class="np-metatag">{g}</span>)}
      </div>

      {festival.notes && <p class="np-article__notes">{festival.notes}</p>}

      <a href={festival.website} target="_blank" rel="noopener noreferrer" class="np-btn np-btn-solid">Visit official website →</a>
    </div>

    <!-- Deadlines + Dates -->
    <div class="grid gap-5 md:grid-cols-2" style="margin-bottom: 22px;">
      <div class="np-panelbox">
        <div class="np-panelbox__h">Deadlines &amp; Fees</div>
        <div class="np-panelbox__body">
          {festival.deadlines.map((d) => (
            <div class={`np-dlrow${d.date < now ? " past" : ""}`}>
              <div>
                <div class="np-dlrow__t">{d.type} deadline{hasShortSchedule ? " (features)" : ""}{d.date < now ? " · passed" : ""}</div>
                <div class="np-dlrow__d">{formatDate(d.date)}</div>
              </div>
              <span class="np-dlrow__fee">{feeText(d.fee, d.shortFee)}</span>
            </div>
          ))}
          {hasShortSchedule && (
            <>
              <div class="np-subhead">Shorts submit earlier</div>
              {festival.shortDeadlines!.map((d) => (
                <div class={`np-dlrow${d.date < now ? " past" : ""}`}>
                  <div>
                    <div class="np-dlrow__t">{d.type} deadline (shorts){d.date < now ? " · passed" : ""}</div>
                    <div class="np-dlrow__d">{formatDate(d.date)}</div>
                  </div>
                  <span class="np-dlrow__fee">{d.fee === 0 ? "Free" : `${d.fee} ${festival.fees.currency}`}</span>
                </div>
              ))}
            </>
          )}
        </div>
      </div>

      <div class="np-panelbox">
        <div class="np-panelbox__h">The Facts</div>
        <div class="np-panelbox__body">
          {festival.festivalDates && (
            <div class="np-factrow">
              <div class="np-factrow__k">Festival dates</div>
              <div class="np-factrow__v">{formatDate(festival.festivalDates.start)} &ndash; {formatDate(festival.festivalDates.end)}</div>
            </div>
          )}
          {festival.notificationDate && (
            <div class="np-factrow">
              <div class="np-factrow__k">Notification</div>
              <div class="np-factrow__v">Expected by {formatDate(festival.notificationDate)}</div>
            </div>
          )}
          {nextDeadline && (
            <div class="np-factrow">
              <div class="np-factrow__k">Next deadline</div>
              <div class="np-factrow__v" style="color: var(--np-red);">{formatDate(nextDeadline.date)}</div>
              <div class="np-dlrow__d" style="margin-top:2px;">{nextDeadline.type} · {feeText(nextDeadline.fee, nextDeadline.shortFee)}</div>
            </div>
          )}
        </div>
      </div>
    </div>

    <!-- Related -->
    {related.length > 0 && (
      <div class="np-panelbox">
        <div class="np-panelbox__h">Also on the circuit</div>
        <div class="np-panelbox__body">
          <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
            {related.map((f) => (
              <a href={`/festivals/${f.id}`} class="np-related-card">
                <div class="np-related-card__n">{f.name}</div>
                <div class="np-related-card__m">
                  <span class={`np-tier${f.tier === "A-list" ? " alist" : ""}`} style="font-size:9px;padding:2px 5px;">{f.tier}</span>
                  {f.location.city}, {f.location.country}
                </div>
              </a>
            ))}
          </div>
        </div>
      </div>
    )}
  </div>
</Layout>
